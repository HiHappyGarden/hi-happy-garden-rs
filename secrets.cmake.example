# Copy this file to secrets.cmake (excluded from git) and fill in your values.
# Only the variables listed in HHG_SECRETS_ALLOWED_VARS (CMakeLists.txt) can be
# set here, any other variable is ignored with a warning.

# --- Required: configuration fails if any of these is missing or empty ---

# AES key/IV derivation salts, combined with the hardware unique_id to generate
# the encryption keys. Changing them makes previously encrypted data unreadable.
set(HHG_AES_KEY_SALT "MyCustomKeySalt2024")
set(HHG_AES_IV_SALT "MyCustomIVSalt2024")

# Default system user (plaintext password, will be hashed)
set(HHG_SYSTEM_USER_EMAIL "admin@hhg.local")
set(HHG_SYSTEM_USER_PASSWORD "change_me")

# --- Optional ---

# WiFi credentials
set(HHG_DEFAULT_WIFI_SSID "ssid_secert")
set(HHG_DEFAULT_WIFI_PASSWORD "passwd_secert")
# set(HHG_DEFAULT_WIFI_AUTH "3")              # 0=Open,1=WPA,2=WPA2,3=WPA2-Mixed
# set(HHG_DEFAULT_WIFI_ENABLED ON)
# set(HHG_DEFAULT_DAYLIGHT_SAVING_ENABLED ON)
