        <mxCell id="c168" value="3V3" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="390" width="44" height="16" as="geometry"/></mxCell>
