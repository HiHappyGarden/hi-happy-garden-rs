        <mxCell id="c157" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c153" target="c156"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c158" value="&lt;b&gt;SW2 – Rotary encoder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;with push button&lt;br&gt;A/B pull-down → C to 3V3&lt;br&gt;SW pull-up → to GND&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;spacingLeft=120;" vertex="1" parent="1"><mxGeometry x="1300" y="276" width="290" height="132" as="geometry"/></mxCell>
